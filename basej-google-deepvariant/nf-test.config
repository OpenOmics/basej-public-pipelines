config {

    testsDir "tests"
    workDir ".nf-test"
    configFile "nextflow.config"
    // CPU-only DeepVariant: call_variants has no GPU on standard runners, so the
    // nf-test always runs the test_cpu profile (CPU image, no --gpus). Production
    // `nextflow run` (no profile) is unaffected and keeps the GPU path.
    profile "test_cpu"

}
